// Prisma schema stub for initial demo (Postgres 16)
// This schema is intentionally minimal and will evolve.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mapping {
  id                  String   @id @default(cuid())
  token               String   @unique
  field_name          String
  original_value_hash String
  original_value_enc  String?  // encrypted value (AES-GCM base64) - client-side encrypted string
  identity_hash       String
  metadata            Json?
  created_at          DateTime @default(now())

  @@index([original_value_hash])
  @@index([identity_hash])
}

model IdentityRecord {
  id            String   @id @default(cuid())
  identity_hash String   @unique
  original_id   String?
  original_name String?
  created_at    DateTime @default(now())
}

model Job {
  id         String   @id @default(cuid())
  type       String
  payload    Json
  status     String   @default("QUEUED")
  attempts   Int      @default(0)
  result     Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  event      String
  details    Json?
  created_at DateTime @default(now())
}
